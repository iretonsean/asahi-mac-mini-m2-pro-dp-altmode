From df57d276533044f020465972f6be879556d9b0e1 Mon Sep 17 00:00:00 2001
From: Sean Ireton <1441621+iretonsean@users.noreply.github.com>
Date: Thu, 17 Sep 2026 22:49:44 +0000
Subject: [PATCH] arm64: dts: apple: t6020-j474s: bless USB-C Back Right Middle
 (atcphy2) for DP alt mode

The Mac Studio dtsi inherited by the M2 Pro mini blesses dcpext1 on atcphy1
(usb-pd@3f). Re-target it to atcphy2 / usb-pd@3b, where the display is, and
away from atcphy0, which carries this machine's external boot disk.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Ay74ZD5KGnArcqfJCsemcZ
---
 arch/arm64/boot/dts/apple/t6020-j474s.dts | 40 +++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6020-j474s.dts b/arch/arm64/boot/dts/apple/t6020-j474s.dts
index cfe7f8ac7..94a10d4c5 100644
--- a/arch/arm64/boot/dts/apple/t6020-j474s.dts
+++ b/arch/arm64/boot/dts/apple/t6020-j474s.dts
@@ -132,3 +132,43 @@ &gpu {
 };
 
 #include "hwmon-mini.dtsi"
+
+/*
+ * USB-C DisplayPort alt mode: t600x-j375.dtsi (included via t602x-j474-j475.dtsi)
+ * blesses dcpext1 on atcphy1 / typec1 ("USB-C Back Left Middle"). On this machine the
+ * display is on typec2 ("USB-C Back Right Middle", usb-pd@3b, atcphy2), and typec0 /
+ * atcphy0 carries the boot disk and must never be repurposed, so re-target dcpext1 to
+ * atcphy2. The t602x crossbar encodes mux-index as 2 * dispext + port, so dispext1
+ * port 0 stays 2; apple,dptx-phy is the ATC PHY number.
+ */
+#ifdef ENABLE_DCPEXT_TYPEC
+&dcpext1 {
+	apple,dptx-phy = <2>;
+	phys = <&atcphy2 PHY_TYPE_DP>;
+	mux-controls = <&atcphy2_xbar 0>;
+};
+
+&atcphy1_xbar {
+	status = "disabled";
+};
+
+&atcphy2_xbar {
+	status = "okay";
+};
+
+&ps_atc1_common {
+	/delete-property/ apple,always-on;
+};
+
+&ps_atc2_common {
+	apple,always-on; /* Needs to stay on for DP-alt suspend/resume */
+};
+
+&typec1 {
+	/delete-property/ displayport;
+};
+
+&typec2 {
+	displayport = <&dcpext1>;
+};
+#endif
-- 
