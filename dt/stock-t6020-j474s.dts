	opp-table-gpu-cs {
		compatible = "operating-points-v2";
		phandle = <0x81>;

		opp00 {
			opp-hz = <0x00 0x18>;
			opp-microvolt = <0xa3160>;
		};

		opp01 {
			opp-hz = <0x00 0x1a76e700>;
			opp-microvolt = <0xa3160>;
		};

		opp02 {
			opp-hz = <0x00 0x247a6100>;
			opp-microvolt = <0xa5870>;
		};

		opp03 {
			opp-hz = <0x00 0x30291a00>;
			opp-microvolt = <0xb3ee8>;
		};

		opp04 {
