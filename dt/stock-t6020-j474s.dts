		};

		opp06 {
			opp-hz = <0x00 0x49abdd00>;
			opp-microvolt = <0xda048>;
		};
	};

	opp-table-gpu-afr {
		compatible = "operating-points-v2";
		phandle = <0x82>;

		opp00 {
			opp-hz = <0x00 0x18>;
			opp-microvolt = <0xa3160>;
		};

		opp01 {
			opp-hz = <0x00 0x17d78400>;
			opp-microvolt = <0xa3160>;
		};

		opp02 {
			opp-hz = <0x00 0x20e6da00>;
			opp-microvolt = <0xa5870>;
		};

		opp03 {
			opp-hz = <0x00 0x2d4cae00>;
			opp-microvolt = <0xb3ee8>;
		};

		opp04 {
			opp-hz = <0x00 0x3a699d00>;
			opp-microvolt = <0xc6f98>;
		};

		opp05 {
			opp-hz = <0x00 0x41722680>;
			opp-microvolt = <0xd2730>;
		};

		opp06 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0xda048>;
		};
	};

	pmu-e {
		compatible = "apple,blizzard-pmu";
		interrupt-parent = <0x15>;
		interrupts = <0x01 0x00 0x04 0x04>;
	};

	pmu-p {
		compatible = "apple,avalanche-pmu";
		interrupt-parent = <0x15>;
		interrupts = <0x01 0x00 0x05 0x04>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x15>;
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupts = <0x01 0x00 0x02 0x04 0x01 0x00 0x03 0x04 0x01 0x00 0x00 0x04 0x01 0x00 0x01 0x04>;
	};

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x26>;
	};

	clock-200m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xbebc200>;
		clock-output-names = "clk_200m";
		phandle = <0x64>;
	};

	clock-disp0 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xf53b040>;
		clock-output-names = "clk_disp0";
		phandle = <0x43>;
	};

	clock-dispext0 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "clk_dispext0";
		phandle = <0x91>;
	};

	clock-dispext0_die1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "clk_dispext0_die1";
	};

	clock-dispext1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "clk_dispext1";
		phandle = <0xcf>;
	};

	clock-dispext1_die1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "clk_dispext1_die1";
	};

	clock-ref-nco {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "nco_ref";
		clock-frequency = <0x3fa86300>;
		phandle = <0x16>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		globals {
			status = "disabled";
			phandle = <0x7f>;
		};

		hw-cal-a {
			status = "disabled";
			phandle = <0x7d>;
		};

		hw-cal-b {
			status = "disabled";
			phandle = <0x7e>;
		};

		uat-handoff {
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x7c>;
		};

		uat-pagetables {
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x7b>;
		};

		uat-ttbs {
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x7a>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		nonposted-mmio;
		dma-ranges = <0x00 0x00 0x00 0x00 0xffffffff 0xffffc000>;

		clock-controller@28e03c000 {
			compatible = "apple,t6020-nco", "apple,t8103-nco", "apple,nco";
			reg = <0x02 0x8e03c000 0x00 0x14000>;
			clocks = <0x16>;
			#clock-cells = <0x01>;
			phandle = <0x72>;
		};

		interrupt-controller@28e100000 {
			compatible = "apple,t6020-aic", "apple,aic2";
			#interrupt-cells = <0x04>;
			interrupt-controller;
			reg = <0x02 0x8e100000 0x00 0xc000 0x02 0x8e10c000 0x00 0x1000>;
			reg-names = "core", "event";
			power-domains = <0x17>;
			phandle = <0x15>;

			affinities {

				e-core-pmu-affinity {
					apple,fiq-index = <0x04>;
					cpus = <0x01 0x02 0x03 0x04>;
				};

				p-core-pmu-affinity {
					apple,fiq-index = <0x05>;
					cpus = <0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c>;
				};
			};
		};

		power-management@28e20c000 {
			compatible = "apple,t6020-pmgr-misc", "apple,t6000-pmgr-misc";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x02 0x8e20c000 0x00 0x400 0x02 0x8e20c400 0x00 0x400>;
			reg-names = "fabric-ps", "dcs-ps";
		};

		iommu@28e300000 {
			compatible = "apple,t6020-dart", "apple,t8110-dart";
			reg = <0x02 0x8e300000 0x00 0x4000>;
			#iommu-cells = <0x01>;
			interrupt-parent = <0x15>;
			interrupts = <0x00 0x00 0x43f 0x04>;
			power-domains = <0x18>;
