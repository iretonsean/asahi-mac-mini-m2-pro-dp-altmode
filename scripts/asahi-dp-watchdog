#!/bin/bash
# asahi-dp-altmode: runs only on the fairydust kernel. Saves the boot result to /var/log/asahi-dp/
# (readable later from the stock kernel), then confirms the boot (fd_tries=0, see
# /etc/grub.d/05_asahi_dp_oneshot). A boot is good when the wired network driver is up (end0 exists,
# so kernel and modules match) or the gateway answers; a router outage alone does not count as a
# failed boot. Otherwise reboot: GRUB then falls back to the stock kernel.
out=/var/log/asahi-dp/test-$(date +%F-%H%M%S).txt; mkdir -p /var/log/asahi-dp
sleep 90
{
  echo "== $(uname -r)  fixup: $(tr -d '\0' < /proc/device-tree/chosen/asahi-dp-altmode,dcpext1 2>/dev/null)"
  # The user and repo path below are filled in by "dp-test.sh setup-default".
  sudo -u @OWNER@ @REPO@/scripts/verify.sh 2>&1
  echo "== dmesg"
  dmesg | grep -iE '315c00000|dispext1|dpxbar|dptx|cd321x|typec|altmode|BTF|apple-dcpext1' | grep -v 'Max chain'
  echo "== drm"; for c in /sys/class/drm/card*-*; do echo "$(basename $c) $(cat $c/status 2>/dev/null)"; done
  echo "== net"; ip -br addr
} > "$out" 2>&1
ln -sf "$out" /var/log/asahi-dp/latest.txt
gw=$(ip -4 route show default | awk '{print $3; exit}')
for i in 1 2 3 4 5 6; do
  { ip link show end0 >/dev/null 2>&1 || { [ -n "$gw" ] && ping -c1 -W2 "$gw" >/dev/null 2>&1; }; } &&
    { echo "boot ok (network driver up)" >> "$out"; grub-editenv /boot/grub/fairydust.env set fd_tries=0; exit 0; }
  sleep 20; gw=$(ip -4 route show default | awk '{print $3; exit}')
done
echo "no network driver after ~4 min: rebooting (GRUB falls back to stock)" >> "$out"; sync; journalctl --sync
systemctl reboot
